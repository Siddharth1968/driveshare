generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  fullName String @map("full_name")
  email String @unique
  passwordHash String @map("password_hash")
  phone String @default("")
  roles String[] @default(["DRIVER"]) @map("role")
  accountStatus String @default("ACTIVE") @map("account_status")
  emailVerified Boolean @default(false) @map("email_verified")
  sessionVersion Int @default(0) @map("session_version")
  notifications Json @default("[]")
  audit Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  spots ParkingSpot[]
  bookings Booking[]
  vehicles Vehicle[]
  reviews Review[]
  blocks BlockedSlot[]
  @@map("users")
}
model ParkingSpot {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title String
  description String
  address String
  city String
  latitude Float
  longitude Float
  timezone String @default("Asia/Kolkata")
  hourlyPrice Int @map("hourly_price")
  vehicleTypes String[] @map("vehicle_type_supported")
  parkingType String @map("parking_type")
  spotNumber String @map("spot_number")
  accessInstructions String @map("access_instructions")
  images String[] @default([])
  approvalStatus String @default("PENDING") @map("approval_status")
  permissionConfirmed Boolean @default(false) @map("permission_confirmed")
  isActive Boolean @default(true) @map("is_active")
  audit Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  availability AvailabilitySlot[]
  bookings Booking[]
  blocks BlockedSlot[]
  reviews Review[]
  @@index([city, approvalStatus, isActive])
  @@index([ownerId])
  @@map("parking_spots")
}
model AvailabilitySlot {
  id String @id @default(uuid()) @db.Uuid
  parkingSpotId String @map("parking_spot_id") @db.Uuid
  spot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict)
  dayOfWeek Int @map("day_of_week")
  startTime String @map("start_time")
  endTime String @map("end_time")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  isActive Boolean @default(true) @map("is_active")
  @@index([parkingSpotId, dayOfWeek])
  @@map("availability_slots")
}
model Vehicle {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  registrationNumber String @map("registration_number")
  vehicleType String @map("vehicle_type")
  vehicleModel String @map("vehicle_model")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings Booking[]
  @@unique([userId, registrationNumber])
  @@map("vehicles")
}
model Booking {
  id String @id @default(uuid()) @db.Uuid
  driverId String @map("driver_id") @db.Uuid
  driver User @relation(fields: [driverId], references: [id], onDelete: Restrict)
  parkingSpotId String @map("parking_spot_id") @db.Uuid
  spot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict)
  vehicleId String @map("vehicle_id") @db.Uuid
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  startTime DateTime @map("start_time") @db.Timestamptz(3)
  endTime DateTime @map("end_time") @db.Timestamptz(3)
  bookingStatus String @default("PAYMENT_PENDING") @map("booking_status")
  paymentStatus String @default("PENDING") @map("payment_status")
  totalAmount Int @map("total_amount")
  priceSnapshot Int @map("price_snapshot")
  termsSnapshot Json @default("{}") @map("terms_snapshot")
  holdExpiresAt DateTime? @map("hold_expires_at") @db.Timestamptz(3)
  occupied Boolean @default(false)
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkoutRequestedAt DateTime? @map("checkout_requested_at") @db.Timestamptz(3)
  actualExitTime DateTime? @map("actual_exit_time") @db.Timestamptz(3)
  overstayMinutes Int @default(0) @map("overstay_minutes")
  fineAmount Int @default(0) @map("fine_amount")
  fineStatus String @default("NONE") @map("fine_status")
  fineCapAt DateTime? @map("fine_cap_at") @db.Timestamptz(3)
  exitConfirmedBy String? @map("exit_confirmed_by") @db.Uuid
  cancellationReason String? @map("cancellation_reason")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey String @unique @map("idempotency_key")
  dispute Json?
  audit Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments Payment[]
  review Review?
  @@index([parkingSpotId, startTime, endTime])
  @@index([driverId, bookingStatus])
  @@map("bookings")
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentType String @map("payment_type")
  amount Int
  paymentMethod String @map("payment_method")
  paymentStatus String @map("payment_status")
  transactionReference String @unique @map("transaction_reference")
  idempotencyKey String @unique @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([bookingId])
  @@map("payments")
}
model Review {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  parkingSpotId String @map("parking_spot_id") @db.Uuid
  spot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict)
  rating Int
  comment String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([parkingSpotId])
  @@map("reviews")
}
model BlockedSlot {
  id String @id @default(uuid()) @db.Uuid
  parkingSpotId String @map("parking_spot_id") @db.Uuid
  spot ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Restrict)
  startTime DateTime @map("start_time") @db.Timestamptz(3)
  endTime DateTime @map("end_time") @db.Timestamptz(3)
  reason String
  createdBy String @map("created_by") @db.Uuid
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([parkingSpotId, startTime])
  @@map("blocked_slots")
}
