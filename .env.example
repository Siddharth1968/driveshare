# Optional for Docker demo; compose supplies local-only defaults.
DATABASE_URL=postgresql://driveshare:driveshare_local@localhost:5432/driveshare?schema=public
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true
# Replace with at least 32 random characters outside the local Docker demo.
SESSION_SECRET=local-demo-only-change-before-any-deployment
HOLD_MINUTES=5
GRACE_MINUTES=10
FINE_INTERVAL_MINUTES=15
FINE_INTERVAL_RUPEES=20
NO_SHOW_GRACE_MINUTES=30
FREE_CANCELLATION_MINUTES=60
LATE_CANCELLATION_PERCENT=10
AFTER_START_CANCELLATION_PERCENT=25
VITE_TILE_URL=
