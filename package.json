{
  "name": "driveshare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api --",
    "test": "npm run test -w apps/api",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-postgres.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "9.2.5",
    "embedded-postgres": "17.6.0-beta.15",
    "prettier": "3.6.2"
  }
}
